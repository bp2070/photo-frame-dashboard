# Home HQ — Calendar Feed Configuration
# Copy this file to .env and fill in your values.
# Then run: wrangler secret put GOOGLE_CAL_ICS_URL

# Google Calendar secret ICS feed URL
# Found at: Google Calendar → Settings → [Calendar name] → Integrate Calendar
# → "Secret address in iCal format" → copy the link
GOOGLE_CAL_ICS_URL=https://calendar.google.com/calendar/ical/...

# Map Google Calendar Labels to dashboard people.
# Create labels in Google Calendar (open event → Labels near the event title).
# Add labels like "Mom", "Dad", "Anya", "Nora" to events.
# The dashboard will assign the right colored lane per person.
# Unlabeled events show up as "Family" events.
#
# Format: JSON object of { "Label Name": "person-id" }
# Person IDs (defined in data.js): dad, mom, anya, nora
GOOGLE_CAL_PEOPLE={"Mom":"mom","Dad":"dad","Anya":"anya","Nora":"nora"}