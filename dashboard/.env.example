# Home HQ — Configuration
# Copy this file to .env, fill in your values, then run:
#   npm run secrets
# This will set all secrets via wrangler in one shot.
#
# Required before running:
#   1. Google OAuth credentials: https://console.cloud.google.com
#      → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      → Add redirect URI: https://your-domain.com/auth/callback
#
#   2. Google Calendar ICS URL:
#      Google Calendar → Settings → [Calendar] → Integrate Calendar
#      → "Secret address in iCal format"
#
#   3. Admin Google email address

# --- OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Secret key for signing session cookies (any random string, 16+ chars).
# Generate one with: openssl rand -hex 32
# Or just type a passphrase you make up.
AUTH_SECRET=

# --- Admin ---
ADMIN_EMAIL=

# --- Calendar ---
GOOGLE_CAL_ICS_URL=
GOOGLE_CAL_PEOPLE={"Mom":"mom","Dad":"dad","Anya":"anya","Nora":"nora"}